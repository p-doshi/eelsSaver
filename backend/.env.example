APP_NAME=Eelgrass Watch
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# Choose one STAC source.
STAC_URL=https://stac.dataspace.copernicus.eu/v1/search
STAC_COLLECTION=sentinel-2-l2a

# Alternate Earth Search-like catalog if you switch later.
# STAC_URL=https://earth-search.aws.element84.com/v1/search
# STAC_COLLECTION=sentinel-2-l2a

MODEL_PATH=backend/models/gbm_model.pkl
MODEL_META_PATH=backend/models/model_meta.json
FRONTEND_ORIGIN=*
CACHE_TTL_SECONDS=900